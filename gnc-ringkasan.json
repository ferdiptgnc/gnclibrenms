   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "gnc-librenms-db"
     },
     "rawSql": "SELECT d.device_id, d.hostname AS Device, IFNULL(d.sysName, '') AS sysName, d.os AS OS, IFNULL(d.hardware, '') AS Hardware, IFNULL(l.location, '') AS Lokasi, IF(d.status = 1, 'UP', 'DOWN') AS Status FROM devices d LEFT JOIN locations l ON l.id = d.location_id WHERE d.`ignore` = 0 AND d.disabled = 0 ORDER BY d.hostname",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
