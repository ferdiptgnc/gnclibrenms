   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "gnc-librenms-db"
     },
     "rawSql": "SELECT d.device_id, d.hostname AS Device, p.ifName AS Port, IFNULL(p.ifAlias, '') AS Deskripsi, ROUND(p.ifInErrors_rate, 3) AS `Error in/dtk`, ROUND(p.ifOutErrors_rate, 3) AS `Error out/dtk` FROM ports p JOIN devices d ON d.device_id = p.device_id WHERE p.deleted = 0 AND (p.ifInErrors_rate > 0 OR p.ifOutErrors_rate > 0) ORDER BY p.ifInErrors_rate + p.ifOutErrors_rate DESC LIMIT 30",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
  },
