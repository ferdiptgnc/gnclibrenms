   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "gnc-librenms-db"
     },
     "rawSql": "SELECT d.device_id, a.timestamp AS Waktu, d.hostname AS Device, r.name AS Alert, r.severity AS Severity, CASE a.state WHEN 1 THEN 'Alert' WHEN 2 THEN 'Ack' WHEN 3 THEN 'Memburuk' WHEN 4 THEN 'Membaik' ELSE a.state END AS Status FROM alerts a JOIN devices d ON d.device_id = a.device_id JOIN alert_rules r ON r.id = a.rule_id WHERE a.state != 0 ORDER BY a.timestamp DESC LIMIT 50",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
  },
  {
