   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "mysql",
      "uid": "gnc-librenms-db"
     },
     "rawSql": "SELECT device_id, hostname AS Device, IFNULL(sysName, '') AS sysName, IFNULL(status_reason, '') AS Penyebab, last_polled AS `Terakhir dipoll` FROM devices WHERE status = 0 AND `ignore` = 0 AND disabled = 0 ORDER BY hostname",
     "format": "table",
     "rawQuery": true,
     "editorMode": "code"
    }
   ]
