# Mount folder branding lewat compose.override.yml (dibangun oleh write_override) agar tetap ada setelah recreate
ensure_brand_mount() {
  if [[ -f $OVR ]] && ! grep -q 'gnclibre' "$OVR"; then
    grep -q '/opt/librenms/html/images/custom' "$OVR" && return 0
    ui_msg "Perlu tindakan manual" "Sudah ada $OVR buatan sendiri.\nTambahkan volume ini ke service librenms:\n  - \"./branding:/opt/librenms/html/images/custom:ro\"" 12
    return 1
  fi
  write_override
}

brand_asset_ok() { # brand_asset_ok <nama file> -> 0 bila file bisa diakses lewat Web UI
  local c; c=$(curl -s -o /dev/null -m 5 -w '%{http_code}' "http://127.0.0.1:$(web_port)/images/custom/$1" 2>/dev/null)
  [[ $c == 200 ]]
}

# brand_apply [logo] [judul] [pesan]
brand_apply() {
  local logo=${1:-gnc-logo.png} title=${2:-$BRAND_TITLE_DEFAULT} msg=${3:-$BRAND_MSG_DEFAULT} ok=1
  ui_info "Menyiapkan file logo..."
  brand_write_assets "$BRD"
  ensure_brand_mount || return 1
  apply_stack || { ui_msg "Gagal" "Web UI tidak kembali normal. Cek: gnclibre logs"; return 1; }
  brand_asset_ok "$logo" || { ui_msg "Gagal" "Logo tidak bisa diakses lewat Web UI (images/custom/$logo).\nDetail: $LOG"; return 1; }
  ui_info "Menyimpan setting tampilan..."
  lnms_c config:set title_image "images/custom/$logo" >>"$LOG" 2>&1 || ok=0
  lnms_c config:set favicon "/images/custom/gnc-favicon.png" >>"$LOG" 2>&1 || ok=0
  lnms_c config:set project_name "$title" >>"$LOG" 2>&1 || ok=0
  lnms_c config:set page_title_suffix "$title" >>"$LOG" 2>&1 || ok=0
  lnms_c config:set login_message "$msg" >>"$LOG" 2>&1 || ok=0
  logf "Branding diterapkan (logo=$logo, judul=$title)"
  if ((ok)); then
    ui_msg "Berhasil" "Branding diterapkan:\n  Logo   : $logo\n  Judul  : $title\n  Pesan  : $msg\n\nMuat ulang halaman (Ctrl+Shift+R) untuk melihat hasilnya." 14
  else
    ui_msg "Sebagian gagal" "Sebagian setting gagal disimpan. Detail: $LOG"; return 1
  fi
}

brand_reset() {
  local ok=1
  ui_info "Mengembalikan tampilan asli LibreNMS..."
  lnms_c config:set title_image "" >>"$LOG" 2>&1 || ok=0
  lnms_c config:set favicon "" >>"$LOG" 2>&1 || ok=0
  lnms_c config:set project_name "LibreNMS" >>"$LOG" 2>&1 || ok=0
  lnms_c config:set page_title_suffix "LibreNMS" >>"$LOG" 2>&1 || ok=0
  lnms_c config:set login_message "$LNMS_MSG_DEFAULT" >>"$LOG" 2>&1 || ok=0
  logf "Branding dikembalikan ke default LibreNMS"
  if ((ok)); then ui_msg "Berhasil" "Tampilan kembali ke logo & judul asli LibreNMS."; else ui_msg "Sebagian gagal" "Detail: $LOG"; return 1; fi
}

brand_current() {
  local k
  for k in title_image favicon project_name page_title_suffix login_message; do
    printf '%-18s: %s\n' "$k" "$(lnms_c config:get "$k" 2>/dev/null | tr -d '\r')"
  done
  echo; echo "Folder branding   : $BRD"; ls -l "$BRD" 2>/dev/null | awk 'NR>1 {print "  " $9 " (" $5 " byte)"}'
}

cfg_get() { lnms_c config:get "$1" 2>/dev/null | tr -d '\r'; }

do_brand_title() {
  local cur t
  cur=$(cfg_get page_title_suffix)
  ui_input t "Judul Halaman" "Judul di tab browser & alt logo (mis. 'Devices | GNC NMS'):" "${cur:-$BRAND_TITLE_DEFAULT}" valid_nonempty "Judul tidak boleh kosong." || return 0
  if lnms_c config:set page_title_suffix "$t" >>"$LOG" 2>&1 && lnms_c config:set project_name "$t" >>"$LOG" 2>&1; then
    ui_msg "Berhasil" "Judul halaman sekarang: $t"
  else ui_msg "Gagal" "Detail: $LOG"; fi
}

do_brand_message() {
  local cur m
  cur=$(cfg_get login_message)
  ui_input m "Pesan Login" "Pesan di bawah form login:" "${cur:-$BRAND_MSG_DEFAULT}" valid_nonempty "Pesan tidak boleh kosong." || return 0
  if lnms_c config:set login_message "$m" >>"$LOG" 2>&1; then ui_msg "Berhasil" "Pesan login diperbarui."; else ui_msg "Gagal" "Detail: $LOG"; fi
}

valid_png_file() { [[ -f $1 && $(head -c 8 "$1" 2>/dev/null | od -An -tx1 | tr -d ' \n') == 89504e470d0a1a0a ]]; }

do_brand_custom_logo() {
  local f title
  ui_input f "Logo Sendiri" "Path file logo PNG di server ini (mis. /root/logo-klien.png).\nSaran: horizontal, tinggi 120-240 px, latar putih/transparan.\nCopy dulu ke server, mis.: scp logo.png root@IP:/root/" "/root/" valid_png_file \
    "File tidak ditemukan atau bukan PNG." || return 0
  brand_write_assets "$BRD"
  install -m 644 "$f" "$BRD/custom-logo.png"
  title=$(cfg_get page_title_suffix)
  [[ -z $title || $title == LibreNMS ]] && title=$BRAND_TITLE_DEFAULT
  brand_apply custom-logo.png "$title" "$(cfg_get login_message)"
}

m_brand() {
  local c
  while true; do
    c=$(ui_menu "Branding" "Tampilan Web UI (logo, favicon, judul, pesan login):" \
      1 "Terapkan branding GNC (logo, favicon, judul, pesan)" 2 "Ubah judul halaman" 3 "Ubah pesan login" \
      4 "Pakai logo sendiri (file PNG)" 5 "Lihat setting sekarang" 6 "Kembalikan tampilan asli LibreNMS" 0 "Kembali") || return 0
    case $c in
      1) brand_apply ;;
      2) do_brand_title ;;
      3) do_brand_message ;;
      4) do_brand_custom_logo ;;
      5) ui_run "Setting Branding" brand_current ;;
      6) ui_yesno "Kembalikan" "Kembalikan logo, judul & pesan login ke bawaan LibreNMS?" no && brand_reset ;;
      0) return 0 ;;
    esac
  done
}

