# ---- compose.override.yml: dibangun ulang dari status modul (gnc.env) ----
write_override() {
  local tmp tz gport n=0
  if [[ -f $OVR ]] && ! grep -q 'gnclibre' "$OVR"; then
    ui_msg "Perlu tindakan manual" "Sudah ada $OVR buatan sendiri, gnclibre tidak akan menimpanya.\nPindahkan/hapus file itu lalu ulangi." 11
    return 1
  fi
  tz=$(envget "$ENVF" TZ); tz=${tz:-Asia/Jakarta}
  gport=$(genv_get GRAFANA_PORT); gport=${gport:-3000}
  tmp=$(mktemp)
  {
    echo "# Dibuat oleh gnclibre — jangan diedit manual, atur lewat menu 'gnclibre'."
    echo "# File ini otomatis dimuat oleh 'docker compose' di folder ini."
    echo "services:"
    if [[ -d $BRD ]]; then n=$((n + 1)); cat <<'EOF'
  librenms:
    volumes:
      - "./branding:/opt/librenms/html/images/custom:ro"
EOF
    fi
    if mod_on OXIDIZED; then n=$((n + 1)); cat <<EOF
  oxidized:
    image: oxidized/oxidized:latest
    container_name: librenms_oxidized
    hostname: librenms-oxidized
    environment:
      TZ: "${tz}"
      CONFIG_RELOAD_INTERVAL: "3600"
    volumes:
      - "./oxidized:/home/oxidized/.config/oxidized"
    restart: always
EOF
    fi
    if mod_on ANALYTICS; then n=$((n + 1)); cat <<EOF
  influxdb:
    image: influxdb:2.7
    container_name: librenms_influxdb
    env_file:
      - "./influxdb.env"
    environment:
      TZ: "${tz}"
    volumes:
      - "./influxdb/data:/var/lib/influxdb2"
      - "./influxdb/config:/etc/influxdb2"
    restart: always
  telegraf:
    image: telegraf:latest
    container_name: librenms_telegraf
    # Jalan sebagai root + NET_RAW agar ping (raw socket) berfungsi juga di LXC unprivileged
    entrypoint: ["/usr/bin/telegraf"]
    command: ["--config", "/etc/telegraf/telegraf.conf"]
    cap_add:
      - NET_RAW
    env_file:
      - "./telegraf.env"
    environment:
      TZ: "${tz}"
    volumes:
      - "./telegraf/telegraf.conf:/etc/telegraf/telegraf.conf:ro"
    depends_on:
      - influxdb
    restart: always
  grafana:
    image: grafana/grafana:latest
    container_name: librenms_grafana
    env_file:
      - "./grafana.env"
    environment:
      TZ: "${tz}"
    ports:
      - target: 3000
        published: ${gport}
        protocol: tcp
    volumes:
      - "./grafana/data:/var/lib/grafana"
      - "./grafana/provisioning:/etc/grafana/provisioning:ro"
      - "./grafana/dashboards:/etc/grafana/dashboards:ro"
    depends_on:
      - influxdb
    restart: always
EOF
    fi
  } >"$tmp"
  [[ -f $OVR ]] && cp -p "$OVR" "$OVR.bak"
  if ((n == 0)); then rm -f "$OVR" "$tmp"; return 0; fi
  cat "$tmp" >"$OVR"; rm -f "$tmp"; chmod 644 "$OVR"
  if ! dc config -q >>"$LOG" 2>&1; then
    if [[ -f $OVR.bak ]]; then cp -p "$OVR.bak" "$OVR"; else rm -f "$OVR"; fi
    ui_msg "Gagal" "compose.override.yml tidak valid, dikembalikan. Detail: $LOG"; return 1
  fi
}

stack_up() { # recreate service yang berubah, hapus container modul yang dinonaktifkan
  local out rc err
  ui_info "Menerapkan perubahan container (download image pertama kali bisa beberapa menit)..."
  out=$(dc up -d --remove-orphans 2>&1); rc=$?
  printf '%s\n' "$out" >>"$LOG"
  if ((rc != 0)); then
    err=$(printf '%s\n' "$out" | grep -iE 'error|fail|denied|conflict' | tail -n 3 | cut -c1-220)
    ui_msg "Container gagal dijalankan" "Pesan dari Docker:\n\n${err:-$(printf '%s\n' "$out" | tail -n 3)}\n\nLog lengkap: $LOG" 18
    return 1
  fi
  wait_web || { ui_msg "Gagal" "Web UI LibreNMS tidak merespons setelah perubahan. Cek: gnclibre logs"; return 1; }
}

# ---- Token API LibreNMS (Sanctum di 26.x, tabel api_tokens di versi lama) ----
api_token_ok() {
  local c
  # shellcheck disable=SC2016
  c=$(dc exec -T -e T="$1" librenms php -r '$x = stream_context_create(["http" => ["header" => "X-Auth-Token: " . getenv("T"), "ignore_errors" => true, "timeout" => 10]]);
    @file_get_contents("http://127.0.0.1:8000/api/v0/oxidized", false, $x);
    echo preg_match("#\s(\d{3})\s#", $http_response_header[0] ?? "", $m) ? $m[1] : "000";' 2>>"$LOG")
  [[ $c == 200 ]]
}

api_token_create() { # tulis token ke stdout
  local admin
  admin=$(info_get "Admin username   "); admin=${admin:-admin}
  dc exec -T --user librenms -e U="$admin" librenms php 2>>"$LOG" <<'PHP'
<?php
require '/opt/librenms/vendor/autoload.php';
$app = require '/opt/librenms/bootstrap/app.php';
$app->make(Illuminate\Contracts\Console\Kernel::class)->bootstrap();
$u = App\Models\User::where('username', getenv('U'))->first();
if (! $u) { try { $u = App\Models\User::role('admin')->first(); } catch (Throwable $e) { $u = null; } }
if (! $u) { $u = App\Models\User::orderBy('user_id')->first(); }
if (! $u) { fwrite(STDERR, "Tidak ada user LibreNMS\n"); exit(1); }
if (method_exists($u, 'createToken')) {
    echo $u->createToken('gnclibre-oxidized')->plainTextToken;
} else {
    $t = bin2hex(random_bytes(16));
    Illuminate\Support\Facades\DB::table('api_tokens')->insert(['user_id' => $u->user_id, 'token_hash' => $t, 'description' => 'gnclibre-oxidized', 'disabled' => 0]);
    echo $t;
}
PHP
}

ensure_api_token() { # token valid -> stdout
  local t
  t=$(genv_get API_TOKEN)
  if [[ -n $t ]] && api_token_ok "$t"; then echo "$t"; return 0; fi
  t=$(api_token_create | tr -d '\r\n')
  [[ -n $t ]] && api_token_ok "$t" || { logf "Token API gagal dibuat/diverifikasi"; return 1; }
  genv_set API_TOKEN "$t"; echo "$t"
}

