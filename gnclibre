genv_get() { envget "$GENV" "$1"; }
genv_set() { [[ -f $GENV ]] || { touch "$GENV"; chmod 600 "$GENV"; }; envset "$GENV" "$1" "$2"; }
mod_on()   { [[ $(genv_get "GNC_MOD_$1") == yes ]]; }
rand_hex() { head -c 64 /dev/urandom | od -An -tx1 | tr -d ' \n' | cut -c1-"${1:-32}"; }
rand_pass() { head -c 1024 /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | cut -c1-"${1:-20}"; }
yq() { local s=${1//\\/\\\\}; s=${s//\"/\\\"}; printf '"%s"' "$s"; }          # string YAML aman
valid_svc_pass() { [[ $1 =~ ^[A-Za-z0-9._@#%+=:,!?^*~-]{8,64}$ ]]; }          # aman untuk env_file
valid_targets() { local t; [[ -n $1 ]] || return 1; for t in $1; do valid_host "$t" || return 1; done; }
valid_cred_user() { [[ $1 =~ ^[A-Za-z0-9._@-]{1,64}$ ]]; }
