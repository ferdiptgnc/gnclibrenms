self_update() {
  local tmp new self
  self=$(readlink -f "$0")
  tmp=$(mktemp)
  say "Mengunduh gnclibre terbaru dari $REPO_RAW ..."
  if command -v curl >/dev/null 2>&1; then curl -fsSL -m 60 "$REPO_RAW/gnclibre" -o "$tmp"
  else wget -qO "$tmp" "$REPO_RAW/gnclibre"; fi || { rm -f "$tmp"; die "Gagal mengunduh. Cek koneksi internet."; }
  new=$(grep -m1 -o 'GNCLIBRE_VERSION="[^"]*"' "$tmp" | cut -d'"' -f2)
  if [[ -z $new ]] || ! bash -n "$tmp" 2>/dev/null; then rm -f "$tmp"; die "File unduhan tidak valid, gnclibre tidak diubah."; fi
  if [[ $new == "$GNCLIBRE_VERSION" ]]; then rm -f "$tmp"; okp "gnclibre sudah versi terbaru ($new)."; return 0; fi
  install -m 755 "$tmp" "$self" && rm -f "$tmp" || die "Gagal menulis $self"
  logf "self-update $GNCLIBRE_VERSION -> $new"
  okp "gnclibre diperbarui: $GNCLIBRE_VERSION -> $new"
}

main() {
  local cmd=${1:-menu} f
  case $cmd in
    -h|--help|help) show_banner; usage; return 0 ;;
    -v|--version|version) echo "gnclibre $GNCLIBRE_VERSION"; return 0 ;;
    menu|status|passwd|restart|update|backup|logs|validate|self-update|branding|module|backup-config|speedtest) ;;
    *) usage; return 1 ;;
  esac
  need_root "$@"
  touch "$LOG" 2>/dev/null && chmod 600 "$LOG" 2>/dev/null
  [[ $cmd == self-update ]] && { self_update; return; }
  command -v docker >/dev/null 2>&1 || die "Docker tidak ditemukan."
  load_env
  case $cmd in
    menu)     ensure_whiptail; TUI=1; main_menu; clear; show_banner; okp "Sampai jumpa." ;;
    status)   show_banner; status_text ;;
    passwd)   ensure_whiptail; TUI=1; do_passwd "${2:-admin}"; local rc=$?; clear; return $rc ;;
    restart)  say "Restart semua container..."; dc restart && wait_web && okp "Web UI siap: $(local_url)" ;;
    update)   do_update ;;
    backup)   say "Backup database..."; if f=$(backup_db); then okp "Backup: $f"; else die "Backup gagal (lihat $LOG)"; fi ;;
    logs)     dc logs -f --tail 100 "${2:-librenms}" ;;
    validate) dc exec -T --user librenms librenms php validate.php ;;
    branding) if [[ ${2:-} == reset ]]; then brand_reset
              else brand_apply "" "${GNC_BRAND_TITLE:-}" "${GNC_BRAND_MESSAGE:-}"; fi ;;
    module)
      case "${2:-}:${3:-}" in
        oxidized:)      oxi_enable "${GNC_OXI_USER:-}" "${GNC_OXI_PASS:-}" "${GNC_OXI_RUIJIE_USER:-}" "${GNC_OXI_RUIJIE_PASS:-}" ;;
        analytics:)     an_enable ;;
        oxidized:off)   mod_disable OXIDIZED ;;
        analytics:off)  mod_disable ANALYTICS ;;
        *) echo "Pemakaian: gnclibre module <oxidized|analytics> [off]"; return 1 ;;
      esac ;;
    backup-config) mod_on OXIDIZED || die "Modul Oxidized belum aktif (gnclibre module oxidized)."
                   okp "$(oxi_backup_now) device masuk antrean backup." ;;
    speedtest)     mod_on ANALYTICS || die "Modul Analitik belum aktif (gnclibre module analytics)."
                   an_speedtest_now ;;
  esac
}

main "$@"
