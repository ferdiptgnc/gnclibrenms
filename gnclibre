lnms_php_get() { # lnms_php_get <url>  -> isi respons (dari dalam jaringan Docker)
  # shellcheck disable=SC2016
  dc exec -T -e URL="$1" librenms php -r 'echo @file_get_contents(getenv("URL"), false, stream_context_create(["http" => ["timeout" => 60]]));' 2>>"$LOG"
}

oxi_node_names() {
  # shellcheck disable=SC2016
  dc exec -T librenms php -r '$n = json_decode(@file_get_contents("http://oxidized:8888/nodes.json"), true) ?: [];
    foreach ($n as $x) { echo $x["name"], "\n"; }' 2>>"$LOG"
}

oxi_status_table() {
  # shellcheck disable=SC2016
  dc exec -T librenms php -r '$n = json_decode(@file_get_contents("http://oxidized:8888/nodes.json"), true);
    if (! is_array($n)) { echo "Oxidized belum merespons (container baru jalan? tunggu 1-2 menit).\n"; exit; }
    if (! $n) { echo "Belum ada device dari LibreNMS (cek token API / device sudah ditambahkan?).\n"; exit; }
    printf("%-22s %-10s %-9s %s\n", "DEVICE", "MODEL", "STATUS", "BACKUP TERAKHIR");
    foreach ($n as $x) { $l = $x["last"] ?? [];
      printf("%-22s %-10s %-9s %s\n", $x["name"], $x["model"] ?? "-", $x["status"] ?? ($l["status"] ?? "-"), $x["time"] ?? ($l["end"] ?? "-")); }' 2>>"$LOG"
  echo
  echo "status: success = backup berhasil, no_connection = tidak bisa SSH, never = belum dicoba"
  echo "Riwayat & diff konfigurasi: Web UI LibreNMS > device > tab Config"
}

oxi_backup_now() {
  local n c=0
  while read -r n; do
    [[ -n $n ]] || continue
    lnms_php_get "http://oxidized:8888/node/next/$n" >/dev/null && c=$((c + 1))
  done < <(oxi_node_names)
  echo "$c"
}

oxi_wait_nodes() { # tunggu Oxidized membaca daftar device dari LibreNMS -> jumlah node
  local i n
  for ((i = 1; i <= 20; i++)); do
    n=$(oxi_node_names | grep -c .)
    ((n > 0)) && { echo "$n"; return 0; }
    sleep 6
  done
  echo 0
}

