    systemctl restart snmpd >>"$LOG" 2>&1
    ip=$(local_ip)
    printf "UPDATE devices SET community='%s' WHERE hostname IN ('%s','127.0.0.1','localhost');\n" "$c" "$ip" | sqlq >>"$LOG" 2>&1
