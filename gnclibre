grafana_url() { local u; u=$(genv_get GRAFANA_URL); [[ -n $u ]] && { echo "${u%/}"; return; }; echo "http://$(local_ip):$(genv_get GRAFANA_PORT)"; }
grafana_ok() { local c; c=$(curl -s -m 5 "http://127.0.0.1:$(genv_get GRAFANA_PORT)/api/health" 2>/dev/null); [[ $c == *'"database"'*'ok'* ]]; }
influx_ok()  { dc exec -T influxdb influx ping >/dev/null 2>&1; }

wait_for() { # wait_for <fungsi> <detik>
  local i
  for ((i = 0; i < $2; i += 5)); do "$1" && return 0; sleep 5; done
  return 1
}

# an_enable  (nilai dari env GNC_* bila mode CLI)
an_enable() {
  local targets iv gp gpass gurl cur_port
  targets=$(genv_get SLA_TARGETS); [[ -n $targets ]] || targets="$(gw_local) 1.1.1.1 8.8.8.8"
  targets=$(trim "${GNC_SLA_TARGETS:-$targets}")
  iv=${GNC_SPEEDTEST_INTERVAL:-$(genv_get SPEEDTEST_INTERVAL)}; iv=${iv:-4h}
  cur_port=$(genv_get GRAFANA_PORT)
  gp=${GNC_GRAFANA_PORT:-${cur_port:-3000}}
  gpass=${GNC_GRAFANA_PASS:-}
  gurl=${GNC_GRAFANA_URL-$(genv_get GRAFANA_URL)}
  if ((TUI)); then
    ui_input targets "Target Ping (SLA)" "IP/host yang di-ping setiap menit, pisahkan spasi.\nSaran: router lokal, gateway ISP (bila tahu), 1.1.1.1, 8.8.8.8" \
      "$targets" valid_targets "Isi IP/hostname yang valid, dipisah spasi." || return 0
    iv=$(ui_menu "Speedtest" "Seberapa sering speedtest dijalankan?\n(Setiap tes memakai bandwidth ratusan MB pada link cepat)" \
      "1h" "Setiap 1 jam" "2h" "Setiap 2 jam" "4h" "Setiap 4 jam (disarankan)" "6h" "Setiap 6 jam" "off" "Nonaktifkan speedtest") || return 0
    while true; do
      ui_input gp "Port Grafana" "Port Web UI Grafana:" "$gp" valid_port "Port harus angka 1-65535." || return 0
      [[ $gp == "$cur_port" ]] && mod_on ANALYTICS && break
      [[ -z $(ss -Hltn "sport = :$gp" 2>/dev/null) ]] && break
      ui_msg "Port dipakai" "Port $gp sudah dipakai aplikasi lain."
    done
    ui_input gurl "URL Publik Grafana (opsional)" "Bila Grafana diakses lewat Cloudflare Tunnel, isi URL-nya.\nContoh: https://grafana.klien.gnclab.online\nKosongkan bila hanya lewat IP lokal." \
      "$gurl" valid_public_url "Format: https://nama.domain (tanpa path)" || return 0
    if [[ -z $(genv_get GRAFANA_PASS) ]]; then
      ui_pass gpass "Password admin Grafana (user: admin)" 8 valid_svc_pass "8-64 karakter, tanpa spasi, \$, kutip, atau backslash." || return 0
    fi
  fi
  valid_targets "$targets" || { ui_msg "Gagal" "Target ping tidak valid: $targets"; return 1; }
  [[ $iv =~ ^([0-9]+[mh]|off)$ ]] || iv=4h
  genv_set SLA_TARGETS "$targets"; genv_set SPEEDTEST_INTERVAL "$iv"
  genv_set GRAFANA_PORT "$gp"; genv_set GRAFANA_URL "${gurl%/}"
  [[ -n $(genv_get GRAFANA_USER) ]] || genv_set GRAFANA_USER admin
  if [[ -z $(genv_get GRAFANA_PASS) ]]; then
    valid_svc_pass "$gpass" || gpass=$(rand_pass 16)
    genv_set GRAFANA_PASS "$gpass"
  fi
  [[ -n $(genv_get INFLUX_TOKEN) ]] || genv_set INFLUX_TOKEN "gnc$(rand_hex 45)"   # awalan huruf: tidak dibaca sebagai angka/JSON
  [[ -n $(genv_get INFLUX_PASS) ]] || genv_set INFLUX_PASS "$(rand_pass 20)"
  [[ -n $(genv_get INFLUX_RETENTION) ]] || genv_set INFLUX_RETENTION "90d"

  an_write_files
  genv_set GNC_MOD_ANALYTICS yes
  write_override || return 1
  if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q 'Status: active'; then ufw allow "$gp/tcp" >>"$LOG" 2>&1; fi
  stack_up || return 1
  dc restart telegraf >>"$LOG" 2>&1            # baca ulang telegraf.conf bila target berubah
  ui_info "Menunggu InfluxDB siap..."
  wait_for influx_ok 90 || { ui_msg "Gagal" "InfluxDB belum siap. Cek: gnclibre logs influxdb"; return 1; }
  ui_info "Mengirim data LibreNMS ke InfluxDB..."
  lnms_c config:set influxdbv2.enable true >>"$LOG" 2>&1
  lnms_c config:set influxdbv2.transport http >>"$LOG" 2>&1
  lnms_c config:set influxdbv2.host influxdb >>"$LOG" 2>&1
  lnms_c config:set influxdbv2.port 8086 >>"$LOG" 2>&1
  lnms_c config:set influxdbv2.organization gnc >>"$LOG" 2>&1
  lnms_c config:set influxdbv2.bucket gnc >>"$LOG" 2>&1
  lnms_c config:set influxdbv2.token "$(genv_get INFLUX_TOKEN)" >>"$LOG" 2>&1
  has_service dispatcher && dc restart dispatcher >>"$LOG" 2>&1
  ui_info "Menunggu Grafana siap..."
  wait_for grafana_ok 120 || { ui_msg "Gagal" "Grafana belum merespons. Cek: gnclibre logs grafana"; return 1; }
  info_set "Grafana          " "$(grafana_url)  (user: $(genv_get GRAFANA_USER))"
  logf "Analitik & SLA aktif (target: $targets, speedtest: $iv)"
  ui_msg "Analitik & SLA aktif" "Grafana : $(grafana_url)\nLogin   : $(genv_get GRAFANA_USER) / (password yang diisi; lihat $GENV)\n\nDashboard GNC: Ringkasan, Kualitas ISP (SLA), Trafik WAN.\nTarget ping : $targets\nSpeedtest   : $iv\n\nData SLA mulai terlihat ±2 menit, trafik WAN setelah polling berikutnya (±5 menit)." 16
}

an_check_data() {
  echo "Jumlah titik data 15 menit terakhir per measurement:"
  # shellcheck disable=SC2016
  dc exec -T influxdb influx query --raw 'from(bucket: "gnc") |> range(start: -15m)
    |> filter(fn: (r) => r._measurement == "ping" or r._measurement == "internet_speed" or r._measurement == "ports")
    |> group(columns: ["_measurement"]) |> count() |> keep(columns: ["_measurement", "_value"])' 2>&1 \
    | awk -F, '/^,_result/ || /^,,/ {print "  " $(NF-1) " : " $NF}' | sed 's/\r//'
  echo
  echo "ping           = data SLA dari Telegraf (harus > 0 setelah 2 menit)"
  echo "internet_speed = hasil speedtest (muncul sesuai jadwal)"
  echo "ports          = trafik interface dari LibreNMS (setelah polling 5 menit)"
}

an_speedtest_now() {
  dc exec -T telegraf telegraf --config /etc/telegraf/telegraf.conf --input-filter internet_speed --once 2>&1 | tail -n 5
  echo; echo "Selesai. Hasil tampil di dashboard 'GNC - Kualitas ISP (SLA)'."
}

grafana_reset_pass() {
  local p
  ui_pass p "Password baru admin Grafana" 8 valid_svc_pass "8-64 karakter, tanpa spasi, \$, kutip, atau backslash." || return 0
  if dc exec -T grafana grafana cli admin reset-admin-password "$p" >>"$LOG" 2>&1; then
    genv_set GRAFANA_PASS "$p"; ui_msg "Berhasil" "Password admin Grafana diganti."
  else ui_msg "Gagal" "Gagal mengganti password. Detail: $LOG"; fi
}

mod_disable() { # mod_disable OXIDIZED|ANALYTICS
  genv_set "GNC_MOD_$1" no
  write_override || return 1
  if [[ $1 == OXIDIZED ]]; then lnms_c config:set oxidized.enabled false >>"$LOG" 2>&1
  else lnms_c config:set influxdbv2.enable false >>"$LOG" 2>&1; has_service dispatcher && dc restart dispatcher >>"$LOG" 2>&1; fi
  stack_up
  logf "Modul $1 dinonaktifkan (data tetap disimpan)"
  ui_msg "Dinonaktifkan" "Modul dimatikan. Data tetap tersimpan di $DIR dan dipakai lagi bila diaktifkan kembali."
}

modules_status() {
  local s
  printf '%-34s %s\n' "Backup konfigurasi (Oxidized)" "$(mod_on OXIDIZED && echo AKTIF || echo nonaktif)"
  printf '%-34s %s\n' "Analitik & SLA (Grafana)" "$(mod_on ANALYTICS && echo AKTIF || echo nonaktif)"
  if mod_on ANALYTICS; then
    printf '  %-32s %s\n' "Grafana" "$(grafana_url) ($(grafana_ok && echo OK || echo TIDAK MERESPONS))"
    printf '  %-32s %s\n' "Target ping" "$(genv_get SLA_TARGETS)"
    printf '  %-32s %s\n' "Speedtest" "$(genv_get SPEEDTEST_INTERVAL)"
  fi
  echo; echo "Container modul:"
  for s in oxidized influxdb telegraf grafana; do
    has_service "$s" && printf '  %-10s %s\n' "$s" "$(dc ps --format '{{.Status}}' "$s" 2>/dev/null | head -n1)"
  done
  return 0
}

m_modules() {
  local c m
  while true; do
    c=$(ui_menu "Modul Analisis" "Oxidized: $(mod_on OXIDIZED && echo AKTIF || echo nonaktif)   |   Analitik & SLA: $(mod_on ANALYTICS && echo AKTIF || echo nonaktif)" \
      1 "Status modul" \
      2 "Backup konfigurasi (Oxidized): aktifkan / ubah kredensial" \
      3 "Jalankan backup konfigurasi sekarang" \
      4 "Status backup per device" \
      5 "Analitik & SLA (Grafana): aktifkan / ubah target" \
      6 "Jalankan speedtest sekarang" \
      7 "Cek data masuk ke InfluxDB" \
      8 "Reset password admin Grafana" \
      9 "Nonaktifkan modul" \
      0 "Kembali") || return 0
    case $c in
      1) ui_run "Status Modul" modules_status ;;
      2) oxi_enable ;;
      3) if mod_on OXIDIZED; then ui_info "Meminta backup semua device..."; ui_msg "Backup dijadwalkan" "$(oxi_backup_now) device masuk antrean backup.\nCek hasilnya 1-2 menit lagi di 'Status backup per device'."; else ui_msg "Belum aktif" "Aktifkan dulu modul Backup konfigurasi."; fi ;;
      4) if mod_on OXIDIZED; then ui_run "Status Backup Konfigurasi" oxi_status_table; else ui_msg "Belum aktif" "Aktifkan dulu modul Backup konfigurasi."; fi ;;
      5) an_enable ;;
      6) if mod_on ANALYTICS && [[ $(genv_get SPEEDTEST_INTERVAL) != off ]]; then ui_run "Speedtest (30-90 detik)" an_speedtest_now; else ui_msg "Tidak tersedia" "Aktifkan modul Analitik & SLA dengan speedtest terlebih dahulu."; fi ;;
      7) if mod_on ANALYTICS; then ui_run "Data InfluxDB" an_check_data; else ui_msg "Belum aktif" "Aktifkan dulu modul Analitik & SLA."; fi ;;
      8) if mod_on ANALYTICS; then grafana_reset_pass; else ui_msg "Belum aktif" "Aktifkan dulu modul Analitik & SLA."; fi ;;
      9) m=$(ui_menu "Nonaktifkan" "Pilih modul (data tidak dihapus):" OXIDIZED "Backup konfigurasi (Oxidized)" ANALYTICS "Analitik & SLA (Grafana)") || continue
         ui_yesno "Konfirmasi" "Nonaktifkan modul $m?" no && mod_disable "$m" ;;
      0) return 0 ;;
    esac
  done
}

