  local u=${1:-} p=${2:-} ru=${3:-} rp=${4:-} tok n
  if ((TUI)); then
    ui_input u "Backup Konfigurasi" "Username SSH perangkat jaringan (MikroTik/Ruijie) untuk backup konfigurasi.\nDisarankan user khusus read-only, mis. 'oxidized'." \
      "$(genv_get OXI_USER)" valid_cred_user "Username 1-64 karakter: huruf, angka, . _ @ -" || return 0
    ui_pass p "Password SSH untuk '$u'" 1 valid_safe_pass "Password tidak boleh mengandung tanda kutip tunggal (')." || return 0
    if ui_yesno "Ruijie" "Apakah perangkat Ruijie memakai username/password yang BERBEDA?\n\n(Ruijie butuh user privilege 15 agar 'show running-config' bisa dibaca)" no; then
      ui_input ru "Kredensial Ruijie" "Username SSH Ruijie:" "$(genv_get OXI_RUIJIE_USER)" valid_cred_user "Username tidak valid." || return 0
      ui_pass rp "Password SSH Ruijie untuk '$ru'" 1 valid_safe_pass "Password tidak boleh mengandung tanda kutip tunggal (')." || return 0
    fi
  fi
  [[ -n $u ]] || u=$(genv_get OXI_USER)
  [[ -n $p ]] || p=$(genv_get OXI_PASS)
  valid_cred_user "$u" && valid_safe_pass "$p" || { ui_msg "Gagal" "Username/password SSH belum diisi atau tidak valid."; return 1; }
  genv_set OXI_USER "$u"; genv_set OXI_PASS "$p"
  genv_set OXI_RUIJIE_USER "$ru"; genv_set OXI_RUIJIE_PASS "$rp"

  ui_info "Membuat & memverifikasi token API LibreNMS..."
  tok=$(ensure_api_token) || { ui_msg "Gagal" "Token API LibreNMS gagal dibuat/diverifikasi.\nPastikan user admin aktif. Detail: $LOG" 11; return 1; }
  oxi_write_config "$tok"
  genv_set GNC_MOD_OXIDIZED yes
  write_override || return 1
  stack_up || return 1
  ui_info "Mengaktifkan integrasi Oxidized di LibreNMS..."
  lnms_c config:set oxidized.enabled true >>"$LOG" 2>&1
  lnms_c config:set oxidized.url "http://oxidized:8888" >>"$LOG" 2>&1
  lnms_c config:set oxidized.features.versioning true >>"$LOG" 2>&1
  lnms_c config:set oxidized.reload_nodes true >>"$LOG" 2>&1
  ui_info "Menunggu Oxidized membaca daftar device dari LibreNMS..."
  n=$(oxi_wait_nodes)
  logf "Oxidized aktif ($n device)"
  ui_msg "Backup konfigurasi aktif" "Oxidized membaca $n device dari LibreNMS. Backup otomatis setiap 24 jam.\n\nPastikan di setiap perangkat ada user SSH '$u':\n  MikroTik: /user add name=$u group=read password=...\n  Ruijie  : username $u privilege 15 password ...\n            (line vty 0 4 > login local)\n\nCek hasil: menu 'Status backup per device', atau\nWeb UI LibreNMS > device > tab Config." 19
}

# ---- Analitik & SLA ----
an_write_files() {
  local d=$DIR tok targets iv url gp urls="" t lnms
  tok=$(genv_get INFLUX_TOKEN); targets=$(genv_get SLA_TARGETS); iv=$(genv_get SPEEDTEST_INTERVAL)
  url=$(genv_get GRAFANA_URL); gp=$(genv_get GRAFANA_PORT); lnms=$(lnms_url)
  mkdir -p "$d/influxdb/data" "$d/influxdb/config" "$d/telegraf" \
    "$d/grafana/data" "$d/grafana/provisioning/datasources" "$d/grafana/provisioning/dashboards" "$d/grafana/dashboards"

  # InfluxDB (variabel INIT hanya dipakai saat data masih kosong)
  cat >"$d/influxdb.env" <<EOF
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=gnc
DOCKER_INFLUXDB_INIT_PASSWORD='$(genv_get INFLUX_PASS)'
DOCKER_INFLUXDB_INIT_ORG=gnc
DOCKER_INFLUXDB_INIT_BUCKET=gnc
DOCKER_INFLUXDB_INIT_RETENTION=$(genv_get INFLUX_RETENTION)
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN='${tok}'
EOF
  printf "INFLUX_TOKEN='%s'\n" "$tok" >"$d/telegraf.env"

  # Telegraf: ping (latency/loss/jitter) + speedtest
  for t in $targets; do urls+="${urls:+, }\"$t\""; done
  {
    cat <<EOF
# Dibuat oleh gnclibre — ubah target lewat menu 'gnclibre' > Modul Analisis
[global_tags]
  site = "$(hostname)"

[agent]
  interval = "60s"
  round_interval = true
  flush_interval = "30s"
  hostname = "$(hostname)"

[[outputs.influxdb_v2]]
  urls = ["http://influxdb:8086"]
  token = "\${INFLUX_TOKEN}"
  organization = "gnc"
  bucket = "gnc"

[[inputs.ping]]
  urls = [${urls}]
  method = "native"
  privileged = true
  count = 10
  ping_interval = "1s"
  deadline = "15s"
  interval = "60s"
EOF
    if [[ $iv != off ]]; then cat <<EOF

[[inputs.internet_speed]]
  interval = "${iv}"
  cache = true
  memory_saving_mode = false
EOF
    fi
  } >"$d/telegraf/telegraf.conf"

  # Grafana
  {
    echo "GF_SECURITY_ADMIN_USER=$(genv_get GRAFANA_USER)"
    echo "GF_SECURITY_ADMIN_PASSWORD='$(genv_get GRAFANA_PASS)'"
    echo "GF_USERS_ALLOW_SIGN_UP=false"
    echo "GF_ANALYTICS_REPORTING_ENABLED=false"
    echo "GF_ANALYTICS_CHECK_FOR_UPDATES=false"
    echo "GF_DASHBOARDS_DEFAULT_HOME_DASHBOARD_PATH=/etc/grafana/dashboards/gnc-ringkasan.json"
    [[ -n $url ]] && echo "GF_SERVER_ROOT_URL=${url%/}/"
    echo "GNC_INFLUX_TOKEN='${tok}'"
    echo "GNC_DB_NAME=$(envget "$ENVF" MYSQL_DATABASE)"
    echo "GNC_DB_USER=$(envget "$ENVF" MYSQL_USER)"
    echo "GNC_DB_PASSWORD='$(envget "$ENVF" MYSQL_PASSWORD)'"
  } >"$d/grafana.env"
  chmod 600 "$d/influxdb.env" "$d/telegraf.env" "$d/grafana.env"

  cat >"$d/grafana/provisioning/datasources/gnc.yaml" <<'EOF'
# Dibuat oleh gnclibre
apiVersion: 1
datasources:
  - name: InfluxDB GNC
    uid: gnc-influx
    type: influxdb
    access: proxy
    url: http://influxdb:8086
    isDefault: true
    jsonData:
      version: Flux
      organization: gnc
      defaultBucket: gnc
      tlsSkipVerify: true
    secureJsonData:
      token: ${GNC_INFLUX_TOKEN}
  - name: LibreNMS DB
    uid: gnc-librenms-db
    type: mysql
    access: proxy
    url: db:3306
    user: ${GNC_DB_USER}
    jsonData:
      database: ${GNC_DB_NAME}
      maxOpenConns: 5
    secureJsonData:
      password: ${GNC_DB_PASSWORD}
EOF
  cat >"$d/grafana/provisioning/dashboards/gnc.yaml" <<'EOF'
# Dibuat oleh gnclibre
apiVersion: 1
providers:
  - name: GNC
    folder: GNC
    type: file
    disableDeletion: true
    allowUiUpdates: false
    options:
      path: /etc/grafana/dashboards
EOF
  grafana_write_dashboards "$d/grafana/dashboards"
  sed -i "s#__LNMS_URL__#${lnms}#g" "$d/grafana/dashboards/"*.json
  chown -R 472:0 "$d/grafana/data" 2>/dev/null
  chmod 755 "$d/grafana" "$d/grafana/dashboards" "$d/grafana/provisioning" "$d/grafana/provisioning/"*
  chmod 644 "$d/grafana/dashboards/"*.json "$d/grafana/provisioning/"*/*.yaml "$d/telegraf/telegraf.conf"
}

